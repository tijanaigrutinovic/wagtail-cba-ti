# Copy to .env for local development or production deployment.
# chmod 600 .env on the server.

DJANGO_SETTINGS_MODULE=cba_site.settings.production
SECRET_KEY=change-this-to-a-random-64-char-secret
DEBUG=False
ALLOWED_HOSTS=cbaeducation.com,www.cbaeducation.com,127.0.0.1,localhost

# PostgreSQL (production). Omit for local SQLite dev (uses cba_site.settings.dev).
DATABASE_URL=postgres://cba_wagtail_user:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/cba_wagtail

# Open edX integration (catalog sync — separate milestone)
OPENEDX_BASE_URL=https://learn.cbaeducation.com
OPENEDX_STUDIO_URL=https://studio.cbaeducation.com
OPENEDX_CLIENT_ID=CHANGE_ME
OPENEDX_CLIENT_SECRET=CHANGE_ME
OPENEDX_API_TOKEN=

# Email (SendGrid or other SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=noreply@cbaeducation.com
