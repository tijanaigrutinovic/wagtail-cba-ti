# Reference systemd unit for Gunicorn (runbook section 5.7).
# Install: sudo cp deploy/systemd/cba-wagtail.service /etc/systemd/system/

[Unit]
Description=CBA Wagtail Gunicorn
After=network.target postgresql.service

[Service]
User=deploy
Group=www-data
WorkingDirectory=/srv/cba-wagtail
EnvironmentFile=/srv/cba-wagtail/.env
ExecStart=/srv/cba-wagtail/.venv/bin/gunicorn \
  --workers 3 \
  --bind unix:/run/cba-wagtail.sock \
  cba_site.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
